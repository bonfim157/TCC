# Modelo de variáveis de ambiente. Copie para .env.local e preencha; .env* não vai para o Git.
# Os valores de banco vêm do Neon (`neon env pull` ou `neon deploy`).

# Aplicação (papel app_tcc, sem posse das tabelas). Com o Neon, use a URL com pooler.
DATABASE_URL=

# Dono do banco: só para migrações e dados de demonstração (npm run cli -w servidor -- migrar).
DATABASE_URL_DONO=

# Login de demonstração (pessoas fictícias). Nunca ligue em produção.
# TCC_LOGIN_DEMO=1

# Front em modo real: aponta para o servidor local (npm run dev:servidor).
# Sem isto, o front usa a API simulada no navegador.
# VITE_API=real
